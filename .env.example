SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/sports_centre_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=GMT%2B8
SPRING_DATASOURCE_USERNAME=your-db-user
SPRING_DATASOURCE_PASSWORD=your-db-password

SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_PASSWORD=your-redis-password

JWT_SECRET=your-base64-encoded-jwt-secret
JWT_EXPIRATION=86400000

GOOGLE_CLIENT_ID=your-google-oauth-client-id

SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=your-smtp-password
SPRING_MAIL_FROM=noreply@example.com

VERIFY_CODE_EXPIRE_MINUTES=5
VERIFY_CODE_RESEND_COOLDOWN_SECONDS=60
